# Graphical installer (removed from the installed system by Calamares itself)
calamares
calamares-settings-debian
qt6-wayland
qml6-module-qtquick
qml6-module-qtquick-window
qml6-module-qtquick-layouts
qml6-module-qtquick-controls
python3-toml
# Dictionary for the installer's "strong password" check (libpwquality/cracklib);
# without it every password fails with "error loading dictionary".
cracklib-runtime

# Disk tools the installer drives (unsquashfs copies the system to the disk)
squashfs-tools
os-prober
efibootmgr
parted
e2fsprogs
btrfs-progs
xfsprogs
dosfstools
# exFAT: what a big stick wants once it goes back to carrying files
# (FAT32 stops at 4 GB per file), and what Windows and macOS both read.
exfatprogs
ntfs-3g
cryptsetup
lvm2
mdadm
grub-pc-bin
grub-efi-amd64-bin
