# Everyday applications and system features expected from a desktop distro.

# Software center with Flatpak/Flathub and apt (like Ubuntu/Fedora)
gnome-software
gnome-software-plugin-flatpak
packagekit
flatpak

# Safety: firewall, automatic security updates, snapshots, compressed RAM swap
ufw
unattended-upgrades
timeshift
inotify-tools
systemd-zram-generator

# Keyring (saved Wi-Fi and app passwords)
gnome-keyring
libpam-gnome-keyring
seahorse

# Utilities
gnome-disk-utility
gnome-system-monitor
baobab
gnome-font-viewer

# Media
celluloid
ffmpeg
gstreamer1.0-plugins-good
gstreamer1.0-plugins-bad
gstreamer1.0-plugins-ugly
gstreamer1.0-libav

# Personal information, mail and web
gnome-calendar
gnome-contacts
# Google, Microsoft, Nextcloud… accounts for Calendar, Contacts and Files
gnome-online-accounts-gtk
gnome-weather
gnome-maps
gnome-clocks
geary

# Media: music, camera, sound recorder
rhythmbox
gnome-snapshot
gnome-sound-recorder

# Tools: scanner, backups, remote desktop, torrents, logs, characters,
# power statistics, device firmware
simple-scan
deja-dup
remmina
transmission-gtk
gnome-logs
gnome-characters
gnome-power-manager
gnome-firmware

# Office
libreoffice-writer
libreoffice-calc
libreoffice-impress
libreoffice-gtk3

# Admin password prompts (polkit agent), SSH server (off by default),
# command-line package tools, screen reader
mate-polkit
openssh-server
packagekit-tools
orca
# on-screen keyboard (Settings → Accessibility)
wvkbd

# Games (the same small set Ubuntu includes)
aisleriot
gnome-mines
gnome-sudoku
gnome-mahjongg

# Quick Look previews in Files (PDF pages, audio and video)
gir1.2-poppler-0.18
libgtk-4-media-gstreamer

# Screenshots: annotate (swappy) and copy text from pictures (Tesseract OCR,
# one language pack per boot-menu language)
swappy
tesseract-ocr
tesseract-ocr-eng
tesseract-ocr-ita
tesseract-ocr-deu
tesseract-ocr-fra
tesseract-ocr-spa
tesseract-ocr-por
tesseract-ocr-nld
tesseract-ocr-pol
tesseract-ocr-swe
tesseract-ocr-tur
tesseract-ocr-rus
tesseract-ocr-ukr
tesseract-ocr-chi-sim
tesseract-ocr-chi-tra
tesseract-ocr-jpn
tesseract-ocr-kor
tesseract-ocr-ara
tesseract-ocr-hin

# Phone integration (notifications, files, clipboard; Settings → Sharing)
kdeconnect

# Fingerprint for sudo and admin prompts (fprintd itself is in hardware.list)
libpam-fprintd

# Aurora AI (the models themselves are downloaded only when a feature is set
# up in Settings → AI): typing dictated text, the keyring for API keys, PDF
# text for search by meaning, the libraries the llama.cpp runtime links to
wtype
gir1.2-secret-1
poppler-utils
libvulkan1
libgomp1
libssl3t64
python3-qrcode
wayvnc
libinput-tools
