# Aurora OS packages (the desktop, its apps and artwork), updated like any
# other package. Switched on automatically once the repository is online
# (see /usr/libexec/aurora-repo-check).
Types: deb
URIs: https://padovanl.github.io/auroraOS/apt
Suites: trixie
Components: main
Signed-By: /usr/share/keyrings/aurora-archive-keyring.gpg
Enabled: no
