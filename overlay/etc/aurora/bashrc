# Aurora OS interactive shell defaults (sourced from /etc/bash.bashrc).
# Override anything in ~/.bashrc.

case $- in *i*) ;; *) return ;; esac

# Debian ships some tools under different names.
command -v batcat >/dev/null && alias bat='batcat'
command -v fdfind >/dev/null && alias fd='fdfind'

alias ls='ls --color=auto --group-directories-first'
alias ll='ls -lh'
alias la='ls -lAh'
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias g='git'
alias lg='lazygit'
alias dc='docker compose'

export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-nvim}"
export MANPAGER="${MANPAGER:-sh -c 'col -bx | batcat -l man -p'}"

# User-local tools (pipx, npm --prefix ~/.local, cargo, go).
for d in "$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/go/bin" /usr/local/go/bin \
         "$HOME/.bun/bin" "$HOME/.deno/bin" "$HOME/.local/share/fnm"; do
    case ":$PATH:" in *":$d:"*) ;; *) [ -d "$d" ] && PATH="$d:$PATH" ;; esac
done
export PATH

HISTSIZE=50000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend

# fzf key bindings: Ctrl-R history search, Ctrl-T file picker.
[ -r /usr/share/doc/fzf/examples/key-bindings.bash ] && . /usr/share/doc/fzf/examples/key-bindings.bash

command -v direnv >/dev/null && eval "$(direnv hook bash)"
command -v fnm >/dev/null && eval "$(fnm env --use-on-cd --shell bash)"

# Prompt: starship with Aurora's config unless the user has their own.
if [ "${EUID:-$(id -u)}" -eq 0 ]; then
    PS1='\u@\h:\w# '
elif command -v starship >/dev/null; then
    [ -f "$HOME/.config/starship.toml" ] || export STARSHIP_CONFIG=/etc/aurora/starship.toml
    eval "$(starship init bash)"
fi

# Aurora AI in the terminal (Settings → AI):
#   ask "what you want to do"   suggests a command and runs it if you agree
#   why                         explains why the last command failed
#   cmd 2>&1 | why              …using the command's output
__aurora_last() {
    local s=$?
    AURORA_LAST_STATUS=$s
    AURORA_LAST_COMMAND=$(HISTTIMEFORMAT='' history 1 | sed 's/^ *[0-9]* *//')
    return $s
}
PROMPT_COMMAND="__aurora_last${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
ask() {
    local h s
    h=$(mktemp)
    AURORA_AI_HISTORY=$h aurora-ai ask "$*"
    s=$?
    [ -s "$h" ] && history -s "$(cat "$h")"
    rm -f "$h"
    return $s
}
why() {
    AURORA_LAST_COMMAND="$AURORA_LAST_COMMAND" AURORA_LAST_STATUS="$AURORA_LAST_STATUS" aurora-ai why
}
