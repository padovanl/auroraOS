#!/bin/bash
# Install the UEFI boot loader so the disk starts on any firmware.
#
# Debian's signed chain (shim -> signed GRUB) goes to \EFI\debian, and a full
# copy of shim and GRUB to the removable-media path \EFI\BOOT (Debian's own
# --force-extra-removable, kept on GRUB updates by the grub2/
# force_efi_extra_removable debconf switch). The signed GRUB always reads
# \EFI\debian\grub.cfg, so both paths reach the same menu. \EFI\BOOT gets no
# fbx64.efi: that fallback tool would try to rewrite NVRAM boot entries.
#
# Hyper-V Generation 2: boot entries written by the guest are unreliable
# (Debian #949751, Launchpad #1272664); after an install the VM skipped the
# disk and went to PXE, while the same disk started in a VM whose firmware had
# no guest-written entries, through "EFI SCSI Device" (\EFI\BOOT\BOOTX64.EFI).
# So on Hyper-V no entry is written (grub2/update_nvram false) and the ones
# Calamares' bootloader module just created for this disk are removed.
#
# Hyper-V with Secure Boot off also gets GRUB itself at \EFI\BOOT\BOOTX64.EFI
# ("direct"), not shim: Debian's monolithic image, with every module built in,
# which reads \EFI\debian\grub.cfg like the signed one. That is the chain seen
# starting on a real Hyper-V host; the shim chain has not been seen starting
# there with Secure Boot off (the tests that seemed to blame it were run on a
# VM whose firmware could not read the disk at all, see HYPERV.md). With
# Secure Boot on, the signed chain stays.
#
# Called by the installer with --install and by apt after package changes
# (/etc/apt/apt.conf.d/99aurora-efi) on systems the installer set up.
set -euo pipefail

marker=/var/lib/aurora/efi-managed
if [ "${1:-}" != --install ] && [ ! -f "$marker" ]; then
    exit 0
fi
[ -d /sys/firmware/efi ] || exit 0
mountpoint -q /boot/efi || { echo 'EFI system partition is not mounted' >&2; exit 1; }

hyperv=0
if [ "$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)" = 'Microsoft Corporation' ] &&
   [ "$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)" = 'Virtual Machine' ]; then
    hyperv=1
fi

# The SecureBoot variable can be missing when it is off.
secure_boot=0
sb=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
if [ -e "$sb" ] && [ "$(od -An -tu1 -j4 -N1 "$sb" 2>/dev/null | tr -d ' ')" = 1 ]; then
    secure_boot=1
fi
direct=0
[ "$hyperv" = 1 ] && [ "$secure_boot" = 0 ] && direct=1

esp_dir=/boot/efi/EFI
# Installed next to Windows or another system that already starts from
# \EFI\BOOT: that copy is theirs (the firmware's last resort for them), so
# Aurora lives in \EFI\debian only, starts from its own boot entry, and
# reaches the other system through its GRUB menu. Decided at installation and
# remembered; on Hyper-V the removable path is needed whatever is there.
shared=0
if [ "${1:-}" = --install ]; then
    if [ "$hyperv" = 0 ] && [ -e "$esp_dir/BOOT/BOOTX64.EFI" ] &&
       find "$esp_dir" -mindepth 1 -maxdepth 1 -type d ! -iname BOOT ! -iname debian |
           grep -q .; then
        shared=1
    fi
elif [ "$(cat "$marker" 2>/dev/null)" = shim-shared ]; then
    shared=1
fi

removable=true
[ "$shared" = 1 ] && removable=false
printf 'grub-efi-amd64 grub2/force_efi_extra_removable boolean %s\n' "$removable" |
    debconf-set-selections
# GRUB's package scripts run grub-install on every GRUB update, into
# \EFI\<GRUB_DISTRIBUTOR> ("aurora", a second copy) and with a new firmware
# entry for it, put first each time. Only this helper installs: no entries
# from the package (the installer's call below adds the one entry), and the
# stray copy and its entries are removed further down.
printf 'grub-efi-amd64 grub2/update_nvram boolean false\n' | debconf-set-selections

args=(--target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=debian
      --uefi-secure-boot --recheck)
[ "$shared" = 1 ] || args+=(--force-extra-removable)
# Only the installer adds a boot entry, and never on Hyper-V; updates just
# refresh the files and leave the firmware's boot order alone.
if [ "${1:-}" = --install ] && [ "$hyperv" = 0 ]; then
    if ! grub-install "${args[@]}"; then
        if [ "$shared" = 1 ]; then
            echo 'Cannot register an EFI boot entry: choose "debian" in the firmware boot menu' >&2
        else
            echo 'Cannot register an EFI boot entry; the disk still boots through \EFI\BOOT' >&2
        fi
        grub-install "${args[@]}" --no-nvram
    fi
else
    grub-install "${args[@]}" --no-nvram
fi

if [ "$hyperv" = 1 ] && [ "${1:-}" = --install ] && command -v efibootmgr >/dev/null; then
    # Remove the entries the bootloader module wrote for this disk's EFI
    # partition, so Hyper-V starts it through "EFI SCSI Device".
    esp=$(findmnt -no SOURCE /boot/efi)
    partuuid=$(lsblk -no PARTUUID "$esp" | tr '[:upper:]' '[:lower:]')
    efibootmgr -v 2>/dev/null | while read -r num rest; do
        case "$num" in Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]*) ;; *) continue ;; esac
        if [ -n "$partuuid" ] && printf '%s' "$rest" | tr '[:upper:]' '[:lower:]' | grep -q "$partuuid"; then
            id=${num#Boot}; id=${id%\*}
            echo "Removing EFI boot entry Boot$id (Hyper-V starts the disk through \\EFI\\BOOT)"
            efibootmgr -q -b "$id" -B || true
        fi
    done
fi

# The copy GRUB's package scripts left in \EFI\aurora, and the firmware
# entries pointing there on this ESP (older systems got one per GRUB update).
stray=$(find "$esp_dir" -mindepth 1 -maxdepth 1 -type d -iname aurora | head -n1)
if [ -n "$stray" ] && [ -e "$stray/grubx64.efi" ]; then
    rm -rf "$stray"
fi
if command -v efibootmgr >/dev/null; then
    esp=$(findmnt -no SOURCE /boot/efi)
    partuuid=$(lsblk -no PARTUUID "$esp" 2>/dev/null | tr '[:upper:]' '[:lower:]')
    efibootmgr -v 2>/dev/null | while read -r num rest; do
        case "$num" in Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]*) ;; *) continue ;; esac
        lower=$(printf '%s' "$rest" | tr '[:upper:]' '[:lower:]')
        if [ -n "$partuuid" ] && printf '%s' "$lower" | grep -q "$partuuid" &&
           printf '%s' "$lower" | grep -qF '\efi\aurora\'; then
            id=${num#Boot}; id=${id%\*}
            echo "Removing EFI boot entry Boot$id (a stray copy in \\EFI\\aurora)"
            efibootmgr -q -b "$id" -B || true
        fi
    done
fi

test -s "$esp_dir/debian/shimx64.efi"
test -s "$esp_dir/debian/grubx64.efi"
grep -q '^search' "$esp_dir/debian/grub.cfg"
if [ "$shared" = 1 ]; then
    : # \EFI\BOOT belongs to the other system: not touched, not checked.
else
    # Both paths must be complete, with no fallback tool in \EFI\BOOT. Newer
    # grub-install copies fbx64.efi there with --force-extra-removable: remove it.
    for d in "$esp_dir"/BOOT "$esp_dir"/boot; do
        rm -f "$d/fbx64.efi" "$d/FBX64.EFI"
    done
    cmp -s "$esp_dir/BOOT/grubx64.efi" "$esp_dir/debian/grubx64.efi"
    test ! -e "$esp_dir/BOOT/fbx64.efi"
    if [ "$direct" = 1 ]; then
        # After the checks above: grub-install (and GRUB's own package scripts on
        # updates, which run before this) put shim there again each time.
        monolithic=/usr/lib/grub/x86_64-efi/monolithic/grubx64.efi
        test -s "$monolithic"
        install -m 0644 "$monolithic" "$esp_dir/BOOT/BOOTX64.EFI"
        cmp -s "$esp_dir/BOOT/BOOTX64.EFI" "$monolithic"
    else
        cmp -s "$esp_dir/BOOT/BOOTX64.EFI" "$esp_dir/debian/shimx64.efi"
    fi
fi
grub-script-check /boot/grub/grub.cfg

mode=shim
[ "$hyperv" = 1 ] && mode=shim-no-nvram
[ "$direct" = 1 ] && mode=direct
[ "$shared" = 1 ] && mode=shim-shared
echo "Aurora EFI installation: $mode"
mkdir -p /var/lib/aurora
printf '%s\n' "$mode" > "$marker"
sync -f /boot/efi
sync -f "$marker"
