// Aurora OS boot splash: logo with a pulsing row of dots underneath.

Window.SetBackgroundTopColor(0.05, 0.03, 0.10);
Window.SetBackgroundBottomColor(0.10, 0.05, 0.15);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 1);

NUM_DOTS = 5;
dot_image = Image("dot.png");
for (i = 0; i < NUM_DOTS; i++) {
    dots[i] = Sprite(dot_image);
    dots[i].SetPosition(Window.GetX() + Window.GetWidth() / 2 + (i - (NUM_DOTS - 1) / 2) * 22 - dot_image.GetWidth() / 2,
                        logo.y + logo.image.GetHeight() + 48, 2);
    dots[i].SetOpacity(0.2);
}

frame = 0;
fun refresh_callback() {
    frame++;
    for (i = 0; i < NUM_DOTS; i++) {
        phase = Math.Sin((frame / 8) - i * 0.7);
        dots[i].SetOpacity(0.25 + 0.75 * Math.Max(phase, 0));
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// --- Password prompt (encrypted disks) ---
prompt_sprite = Sprite();
bullets_sprite = Sprite();

fun display_password_callback(prompt, bullets) {
    prompt_sprite.SetImage(Image.Text(prompt, 0.95, 0.93, 0.98));
    prompt_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - prompt_sprite.GetImage().GetWidth() / 2,
                              logo.y + logo.image.GetHeight() + 90, 3);
    text = "";
    for (i = 0; i < bullets; i++) text += "•";
    bullets_sprite.SetImage(Image.Text(text, 0.95, 0.93, 0.98));
    bullets_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - bullets_sprite.GetImage().GetWidth() / 2,
                               logo.y + logo.image.GetHeight() + 120, 3);
}

fun display_normal_callback() {
    prompt_sprite.SetOpacity(0);
    bullets_sprite.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// --- Messages ---
message_sprite = Sprite();
fun message_callback(text) {
    message_sprite.SetImage(Image.Text(text, 0.7, 0.66, 0.78));
    message_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - message_sprite.GetImage().GetWidth() / 2,
                               Window.GetY() + Window.GetHeight() - 60, 3);
}
Plymouth.SetMessageFunction(message_callback);
