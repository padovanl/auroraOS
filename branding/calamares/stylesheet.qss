/* Aurora look for the Qt-based installer. */

QWidget {
    font-family: "Inter";
    font-size: 11pt;
}

#mainApp, #mainApp QWidget {
    background-color: #1a1625;
    color: #f2eefa;
}

#sidebarApp, #sidebarApp QWidget {
    background-color: #14101e;
}

QPushButton {
    background-color: #2a2438;
    border: 1px solid #3a3150;
    border-radius: 8px;
    padding: 6px 16px;
    color: #f2eefa;
}

QPushButton:hover { background-color: #332a45; }

QPushButton:default, #view-button-next {
    background-color: #a970ff;
    border-color: #a970ff;
    color: #ffffff;
}

QLineEdit, QComboBox, QSpinBox, QListView, QTreeView, QTextBrowser {
    background-color: #221d30;
    border: 1px solid #3a3150;
    border-radius: 6px;
    color: #f2eefa;
    selection-background-color: #a970ff;
    padding: 4px;
}

QLineEdit:focus, QComboBox:focus { border-color: #a970ff; }

/* Combo boxes: a soft outline like the text fields, a chevron, and a normal
   drop-down list. (combobox-popup: 0 — the default style opens a window with
   every item at once: hundreds of keyboard layouts or time zones.) */
QComboBox {
    combobox-popup: 0;
    min-height: 24px;
    padding: 5px 34px 5px 12px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9px;
    background-color: #221d30;
}
QComboBox:hover { border-color: #cba4ff; background-color: #272136; }
QComboBox:on, QComboBox:focus { border-color: #a970ff; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 30px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow { image: url(/etc/calamares/branding/aurora/chevron.png); width: 16px; height: 16px; }
QComboBox::down-arrow:on { top: 1px; }
QComboBox QAbstractItemView {
    background-color: #221d30;
    color: #f2eefa;
    border: 1px solid #3a3150;
    border-radius: 9px;
    padding: 4px;
    outline: 0;
    selection-background-color: rgba(169, 112, 255, 0.35);
    selection-color: #ffffff;
}
QComboBox QAbstractItemView::item { min-height: 28px; padding: 2px 10px; border-radius: 6px; }
QComboBox QAbstractItemView::item:hover { background-color: rgba(255, 255, 255, 0.07); }
QComboBox QAbstractItemView::item:selected { background-color: rgba(169, 112, 255, 0.35); }

/* Message boxes ("Continue with installation?") are windows of their own:
   the dark look too. (Their last line used to be cut off: with Qt's own
   title bar drawn inside the window, the dialog lost its height; Wayfire now
   draws title bars for Qt apps, see wayfire.ini.) */
QMessageBox { background-color: #1a1625; }
QMessageBox QLabel { color: #f2eefa; }

QRadioButton, QCheckBox, QLabel { color: #f2eefa; background: transparent; }

/* Checkboxes and radio buttons: soft outlines, a violet glow on hover, and a
   violet-to-rose fill with a white mark when chosen. The marks are PNGs made
   by branding/render.py (style sheets would need an extra plugin for SVG). */
QCheckBox, QRadioButton { spacing: 12px; padding: 8px 0; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 1px solid rgba(255, 255, 255, 0.30);
    background-color: rgba(255, 255, 255, 0.05);
}
QCheckBox::indicator { border-radius: 7px; }
QRadioButton::indicator { border-radius: 11px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #cba4ff;
    background-color: rgba(169, 112, 255, 0.16);
}
QCheckBox::indicator:focus, QRadioButton::indicator:focus { border: 1px solid #e7d8ff; }
QCheckBox::indicator:checked, QCheckBox::indicator:indeterminate,
QRadioButton::indicator:checked {
    border: 1px solid #c79dff;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 #a970ff, stop: 1 #ff6f91);
}
QCheckBox::indicator:checked:hover, QRadioButton::indicator:checked:hover {
    border-color: #ffffff;
}
QCheckBox::indicator:checked { image: url(/etc/calamares/branding/aurora/check.png); }
QCheckBox::indicator:indeterminate { image: url(/etc/calamares/branding/aurora/dash.png); }
QRadioButton::indicator:checked { image: url(/etc/calamares/branding/aurora/radio.png); }
QCheckBox:disabled, QRadioButton:disabled { color: #8d8399; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.03);
}
QCheckBox::indicator:checked:disabled, QRadioButton::indicator:checked:disabled {
    background-color: #4d3f63;
}

QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #2a2438;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #a970ff, stop:1 #ff6f91);
}
