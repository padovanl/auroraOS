/* Aurora look for the Qt-based installer. */

QWidget {
    font-family: "Inter";
    font-size: 11pt;
}

/* The window is dark; what is inside it is transparent unless a rule below
   says otherwise. (Painting every child dark here outranks the rules for
   buttons and fields, and flattens them.) */
#mainApp { background-color: #1a1625; border-radius: 8px; }
#mainApp QWidget { color: #f2eefa; }
#mainApp QStackedWidget, #mainApp QFrame, #mainApp QScrollArea { background-color: transparent; }

/* The header (calamares-sidebar.qml): the title with its buttons, then the
   steps. */
#mainApp > QQuickWidget, #backgroundWidget > QQuickWidget { min-height: 96px; max-height: 96px; }

/* Room around each page, like a sheet of paper inside the window. */
#mainApp QStackedWidget { padding: 4px 26px 0 26px; }

#mainApp #slideshow QTabWidget::pane {
    border: none;
    border-radius: 8px;
    background-color: #1b1428;
}
#mainApp #slideshow QStackedWidget {
    padding: 0;
    border-radius: 8px;
    background-color: #1b1428;
}

/* The legend under each partition bar, a little apart from it. Calamares
   paints the partitions' names in black whatever the style, so the card is
   light: Aurora's lavender, not white (a gradient comes out in stripes). */
#mainApp PartitionLabelsView {
    background-color: #e4d9ff;
    border-radius: 12px;
    padding: 4px 12px;
    margin: 10px 0 10px 0;
    min-height: 46px;
}

/* Buttons: pills. "Next" (and the default button of dialogs) is filled with
   the accent gradient, like the one button that moves an installer forward;
   "Back" and "Cancel" stay quiet. */
QPushButton {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    min-height: 22px;
    padding: 7px 22px;
    color: #f2eefa;
    font-weight: 600;
}
QPushButton { outline: none; }
QPushButton:hover { background-color: rgba(255, 255, 255, 0.11); border-color: rgba(255, 255, 255, 0.22); }
QPushButton:pressed { background-color: rgba(255, 255, 255, 0.16); }
QPushButton:disabled { color: #6f667d; background-color: rgba(255, 255, 255, 0.03); border-color: rgba(255, 255, 255, 0.06); }
QPushButton:default, #view-button-next {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #a970ff, stop: 1 #ff6f91);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #ffffff;
    padding: 7px 30px;
}
QPushButton:default:hover, #view-button-next:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #b884ff, stop: 1 #ff85a2);
}
#view-button-next:disabled {
    background-color: rgba(169, 112, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.06);
    color: #8d8399;
}
#view-button-cancel { background-color: transparent; border-color: transparent; color: #b3aac6; }
#view-button-cancel:hover { background-color: rgba(255, 111, 145, 0.14); color: #ffffff; }

/* Fields and lists: soft, roomy, with the accent on focus. */
QLineEdit, QSpinBox, QListView, QTreeView, QTextBrowser, QPlainTextEdit {
    background-color: #221d30;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    color: #f2eefa;
    selection-background-color: #a970ff;
    selection-color: #ffffff;
    padding: 4px;
}
QLineEdit { min-height: 24px; min-width: 250px; padding: 6px 12px; }
QLineEdit:hover { border-color: rgba(255, 255, 255, 0.22); }
QLineEdit:focus, QSpinBox:focus { border: 1px solid #a970ff; background-color: #272136; }
QLineEdit:disabled { color: #8d8399; background-color: #1d1929; }
QListView, QTreeView { outline: 0; padding: 6px; }
QListView::item, QTreeView::item { min-height: 28px; padding: 2px 8px; border-radius: 7px; }
QListView::item:hover, QTreeView::item:hover { background-color: rgba(255, 255, 255, 0.06); }
QListView::item:selected, QTreeView::item:selected {
    background-color: rgba(169, 112, 255, 0.38);
    color: #ffffff;
}
QHeaderView::section {
    background-color: transparent; color: #b3aac6; border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.10); padding: 6px 8px; font-weight: 600;
}

/* Thin scroll bars without arrows. */
QScrollBar:vertical { background: transparent; border: none; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; border: none; height: 10px; margin: 2px; }
QScrollBar::handle { background-color: rgba(255, 255, 255, 0.20); border-radius: 3px; min-height: 28px; min-width: 28px; }
QScrollBar::handle:hover { background-color: rgba(169, 112, 255, 0.65); }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea { border: none; }
QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; }

QToolTip {
    background-color: #2a2438; color: #f2eefa;
    border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 8px; padding: 6px 9px;
}
QGroupBox {
    border: 1px solid rgba(255, 255, 255, 0.10); border-radius: 12px;
    margin-top: 12px; padding: 12px 10px 8px 10px;
}
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; color: #b3aac6; }

/* Combo boxes: a soft outline like the text fields, a chevron, and a normal
   drop-down list. (combobox-popup: 0 — the default style opens a window with
   every item at once: hundreds of keyboard layouts or time zones.) */
QComboBox {
    combobox-popup: 0;
    min-height: 24px;
    padding: 5px 34px 5px 12px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9px;
    background-color: #221d30;
}
QComboBox:hover { border-color: #cba4ff; background-color: #272136; }
QComboBox:on, QComboBox:focus { border-color: #a970ff; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 30px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow { image: url(/etc/calamares/branding/aurora/chevron.png); width: 16px; height: 16px; }
QComboBox::down-arrow:on { top: 1px; }
QComboBox QAbstractItemView {
    background-color: #221d30;
    color: #f2eefa;
    border: 1px solid #3a3150;
    border-radius: 9px;
    padding: 4px;
    outline: 0;
    selection-background-color: rgba(169, 112, 255, 0.35);
    selection-color: #ffffff;
}
QComboBox QAbstractItemView::item { min-height: 28px; padding: 2px 10px; border-radius: 6px; }
QComboBox QAbstractItemView::item:hover { background-color: rgba(255, 255, 255, 0.07); }
QComboBox QAbstractItemView::item:selected { background-color: rgba(169, 112, 255, 0.35); }

/* Message boxes ("Continue with installation?") are windows of their own:
   the dark look too. (Their last line used to be cut off by Qt's own title
   bar drawn inside the window: Qt draws none now.) */
QMessageBox, QDialog { background-color: #1a1625; color: #f2eefa; }
/* They have no title bar either (see aurora-installer): an accent edge sets
   them apart from the page under them. */
QMessageBox, QDialog { border: 1px solid rgba(169, 112, 255, 0.55); padding: 10px; }
QDialog QLabel { color: #f2eefa; }
QMessageBox QLabel { color: #f2eefa; }
QMessageBox QPushButton { padding: 6px 18px; min-width: 96px; }
QMessageBox QPushButton:default { padding: 6px 18px; }

QRadioButton, QCheckBox, QLabel { color: #f2eefa; background: transparent; }

/* Checkboxes and radio buttons: soft outlines, a violet glow on hover, and a
   violet-to-rose fill with a white mark when chosen. The marks are PNGs made
   by branding/render.py (style sheets would need an extra plugin for SVG). */
QCheckBox, QRadioButton { spacing: 12px; padding: 8px 0; }
/* The disk page's options sit closer, so all four (and Erase disk's swap and
   file system menus) fit without a scroll bar. */
#m_itemsScrollArea QRadioButton { padding: 0; }
#m_itemsScrollArea QComboBox { min-height: 22px; padding-top: 3px; padding-bottom: 3px; }
#m_encryptWidget QLineEdit { min-height: 18px; padding: 4px 12px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 1px solid rgba(255, 255, 255, 0.30);
    background-color: rgba(255, 255, 255, 0.05);
}
QCheckBox::indicator { border-radius: 7px; }
QRadioButton::indicator { border-radius: 11px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #cba4ff;
    background-color: rgba(169, 112, 255, 0.16);
}
QCheckBox::indicator:focus, QRadioButton::indicator:focus { border: 1px solid #e7d8ff; }
QCheckBox::indicator:checked, QCheckBox::indicator:indeterminate,
QRadioButton::indicator:checked {
    border: 1px solid #c79dff;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 #a970ff, stop: 1 #ff6f91);
}
QCheckBox::indicator:checked:hover, QRadioButton::indicator:checked:hover {
    border-color: #ffffff;
}
QCheckBox::indicator:checked { image: url(/etc/calamares/branding/aurora/check.png); }
QCheckBox::indicator:indeterminate { image: url(/etc/calamares/branding/aurora/dash.png); }
QRadioButton::indicator:checked { image: url(/etc/calamares/branding/aurora/radio.png); }
QCheckBox:disabled, QRadioButton:disabled { color: #8d8399; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.03);
}
QCheckBox::indicator:checked:disabled, QRadioButton::indicator:checked:disabled {
    background-color: #4d3f63;
}

QProgressBar {
    border: none;
    border-radius: 8px;
    min-height: 16px;
    max-height: 16px;
    background-color: rgba(255, 255, 255, 0.08);
    text-align: center;
    color: #ffffff;
    font-size: 9pt;
    font-weight: 600;
}

QProgressBar::chunk {
    border-radius: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #a970ff, stop:1 #ff6f91);
}
