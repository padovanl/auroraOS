---
componentName: aurora

welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 1024px,680px
windowPlacement: center
sidebar: widget
navigation: widget

strings:
    productName:         "Aurora OS"
    shortProductName:    "Aurora"
    version:             "@VERSION@"
    shortVersion:        "@VERSION@"
    versionedName:       "Aurora OS @VERSION@"
    shortVersionedName:  "Aurora @VERSION@"
    bootloaderEntryName: "Aurora"
    productUrl:          "https://github.com/padovanl/auroraOS"
    supportUrl:          ""
    knownIssuesUrl:      ""
    releaseNotesUrl:     ""

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI:            1

style:
   SidebarBackground:        "#14101e"
   SidebarText:              "#cfc7dd"
   SidebarTextCurrent:       "#ffffff"
   SidebarBackgroundCurrent: "#a970ff"

uploadServer:
    type: "none"
