#!/bin/sh
# aurora-idle-suspend ac|battery — called by aurora-idle's timeouts: suspend only
# if the computer is currently on that power source.

on_ac() {
    found=no
    for s in /sys/class/power_supply/*; do
        [ "$(cat "$s/type" 2>/dev/null)" = Mains ] || continue
        found=yes
        [ "$(cat "$s/online" 2>/dev/null)" = 1 ] && return 0
    done
    # Desktops without a battery report no mains supply: they are plugged in.
    [ "$found" = no ] && ! ls /sys/class/power_supply/BAT* >/dev/null 2>&1
}

case "$1" in
    ac) on_ac && exec systemctl suspend ;;
    battery) on_ac || exec systemctl suspend ;;
esac
exit 0
