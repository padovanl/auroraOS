#!/bin/sh
# Start an Aurora desktop session (used by greetd and wayland-sessions).

case "${1:-wayfire}" in
    wayfire|labwc) compositor="${1:-wayfire}" ;;
    *) echo "aurora-session: unknown compositor" >&2; exit 2 ;;
esac
export AURORA_COMPOSITOR="$compositor"

# Language: system default, then the user's choice from Settings.
[ -r /etc/default/locale ] && . /etc/default/locale
[ -r "$HOME/.config/aurora/locale.conf" ] && . "$HOME/.config/aurora/locale.conf"
export LANG LANGUAGE LC_TIME LC_NUMERIC LC_MONETARY LC_MEASUREMENT LC_PAPER

# Keyboard: system default, then the user's choice from Settings.
[ -r /etc/default/keyboard ] && . /etc/default/keyboard
[ -r "$HOME/.config/aurora/keyboard.conf" ] && . "$HOME/.config/aurora/keyboard.conf"
export XKB_DEFAULT_MODEL="${XKBMODEL:-pc105}"
export XKB_DEFAULT_LAYOUT="${XKBLAYOUT:-us}"
export XKB_DEFAULT_VARIANT="${XKBVARIANT:-}"
export XKB_DEFAULT_OPTIONS="${XKBOPTIONS:-}"

# greetd does not run a login shell: give the session the usual login PATH.
PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games"
export PATH

export XDG_CURRENT_DESKTOP="Aurora:wlroots"
export XDG_SESSION_DESKTOP="aurora"
export XDG_SESSION_TYPE="wayland"
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME=gnome
export SDL_VIDEODRIVER="wayland,x11"
export _JAVA_AWT_WM_NONREPARENTING=1
export GTK_USE_PORTAL=1

# A new compositor must start with a fresh shell. The logout marker keeps the
# previous session's crash watchdog from launching one during teardown.
rm -f "${XDG_RUNTIME_DIR:-/tmp}/aurora-logging-out"

# Renderers that draw correctly on this machine (software ones in VMs).
. /usr/libexec/aurora-render-env

# Hyper-V's display has no 3D, so Wayfire 0.9 must draw with Mesa's software
# GLES there, and its frames flicker on hyperv_drm (full rerendering, linear
# buffers, a software cursor and legacy KMS flips did not cure it). labwc draws
# with wlroots' pixman renderer, which is steady on that display; the shell's
# and GTK's own transitions still run. "wayfire" in ~/.config/aurora/compositor
# brings Wayfire back there.
if [ "$compositor" = wayfire ] && [ "${AURORA_HYPERV_SOFTWARE:-0}" = 1 ] &&
   [ "$(cat "$HOME/.config/aurora/compositor" 2>/dev/null)" != wayfire ]; then
    compositor=labwc
    export AURORA_COMPOSITOR=labwc
fi

# Keep labwc's configuration for the fallback session and as Aurora Settings'
# shared source. Wayfire gets an INI rendered from the same preferences.
cfg="$HOME/.config/labwc"
if [ ! -f "$cfg/rc.xml" ]; then
    mkdir -p "$cfg"
    cp -n /usr/share/aurora/labwc/* "$cfg/" 2>/dev/null
fi
[ -f "$cfg/rc.xml" ] || cfg=/usr/share/aurora/labwc
# The session's own startup script is Aurora's, not the user's (their apps go
# in XDG autostart): keep it current after updates.
[ "$cfg" = "$HOME/.config/labwc" ] && cp /usr/share/aurora/labwc/autostart "$cfg/autostart" 2>/dev/null

# First login: write the GTK stylesheet imports for the chosen window style.
[ -f "$HOME/.config/gtk-4.0/gtk.css" ] || aurora-look >/dev/null 2>&1

if [ "$compositor" = labwc ]; then
    exec labwc -C "$cfg"
fi

if ! command -v wayfire >/dev/null 2>&1; then
    echo "aurora-session: Wayfire unavailable; starting labwc" >&2
    export AURORA_COMPOSITOR=labwc
    exec labwc -C "$cfg"
fi

# Wayfire 0.9 renders with GLES. The VM pixman renderer selected for labwc is
# not usable by Wayfire; Mesa's software GLES is the fallback on those hosts.
if [ "${WLR_RENDERER:-}" = pixman ]; then
    fallback_renderer=pixman
    WLR_RENDERER=gles2
    LIBGL_ALWAYS_SOFTWARE=1
    # wlroots refuses llvmpipe unless explicitly allowed. On Hyper-V this
    # otherwise aborts Wayfire before it can open a desktop session.
    WLR_RENDERER_ALLOW_SOFTWARE=1
    export WLR_RENDERER LIBGL_ALWAYS_SOFTWARE WLR_RENDERER_ALLOW_SOFTWARE
fi
# Hyper-V can run Mesa's software GLES, but its synthetic display has shown
# stale cursor/window fragments with Wayfire's incremental damage tracking.
# -R rerenders damaged frames; modifier-free DRM/EGL buffers and a software
# cursor avoid assumptions the synthetic display does not reliably satisfy.
set --
if [ "${AURORA_HYPERV_SOFTWARE:-0}" = 1 ]; then
    WLR_DRM_NO_MODIFIERS=1
    WLR_EGL_NO_MODIFIERS=1
    WLR_NO_HARDWARE_CURSORS=1
    export WLR_DRM_NO_MODIFIERS WLR_EGL_NO_MODIFIERS WLR_NO_HARDWARE_CURSORS
    set -- -R
fi
wayfire_cfg=$(aurora-wayfire-config) || {
    echo "aurora-session: cannot render Wayfire configuration; starting labwc" >&2
    export AURORA_COMPOSITOR=labwc
    exec labwc -C "$cfg"
}
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/aurora"
mkdir -p "$state_dir"
chmod 700 "$state_dir"
failure_log="$state_dir/compositor-failure.log"
rm -f "$failure_log"
umask 077
wayfire "$@" -c "$wayfire_cfg" 2>"$failure_log" &
compositor_pid=$!
started=$(date +%s)
pidfile="${XDG_RUNTIME_DIR:-/tmp}/aurora-wayfire.pid"
printf '%s\n' "$compositor_pid" > "$pidfile"
if wait "$compositor_pid"; then
    result=0
else
    result=$?
fi
rm -f "$pidfile"
if [ "$result" -ne 0 ] && [ "$(($(date +%s) - started))" -lt 15 ] &&
   [ ! -e "${XDG_RUNTIME_DIR:-/tmp}/aurora-logging-out" ]; then
    echo "aurora-session: Wayfire failed to start; falling back to labwc" >&2
    printf '\nAurora: Wayfire exited with status %s; labwc fallback started.\n' "$result" >> "$failure_log"
    export AURORA_COMPOSITOR=labwc
    [ -z "${fallback_renderer:-}" ] || { WLR_RENDERER="$fallback_renderer"; export WLR_RENDERER; }
    exec labwc -C "$cfg"
fi
[ "$result" -ne 0 ] || rm -f "$failure_log"
exit "$result"
