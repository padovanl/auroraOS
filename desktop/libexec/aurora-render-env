#!/bin/sh
# Sourced by aurora-session and aurora-greeter-launch: pick renderers that draw
# correctly on this machine.
#
# Without a real GPU (virtual machines, simpledrm) the compositor's GLES renderer
# and GTK's GL/Vulkan renderers run on Mesa's software rasterizers, and their
# partial redraws leave stale regions on screen (half-erased windows, a top bar
# that is only partly repainted). There, the compositor uses wlroots' pixman
# renderer and GTK its cairo renderer, which are correct and fast enough. Real
# GPUs keep hardware rendering. Variables that are already set always win.

aurora_software_gpu() {
    ls "${AURORA_DRI_DEVICES:-/dev/dri}"/renderD* >/dev/null 2>&1 || return 0
    for vendor in "${AURORA_DRM_SYSFS:-/sys/class/drm}"/card[0-9]*/device/vendor; do
        [ -r "$vendor" ] || continue
        case "$(cat "$vendor")" in
            # virtio, VMware, QEMU std VGA, QXL, VirtualBox, Hyper-V, Cirrus
            0x1af4|0x15ad|0x1234|0x1b36|0x80ee|0x1414|0x1013) ;;
            *) return 1 ;;
        esac
    done
    return 0
}

aurora_hyperv_gpu() {
    for device in "${AURORA_DRM_SYSFS:-/sys/class/drm}"/card[0-9]*/device; do
        [ -d "$device" ] || continue
        [ "$(cat "$device/vendor" 2>/dev/null)" = "0x1414" ] && return 0
        driver=$(readlink -f "$device/driver" 2>/dev/null) || continue
        [ "${driver##*/}" = hyperv_drm ] && return 0
    done
    return 1
}

# "Try Aurora OS (safe graphics)": software rendering whatever the GPU. (Not
# nomodeset: Debian's kernel has no simpledrm, so without a KMS driver there is
# no display a Wayland compositor can use, only a text console.)
if grep -qw aurora.safegraphics /proc/cmdline 2>/dev/null; then
    : "${WLR_RENDERER:=pixman}" "${GSK_RENDERER:=cairo}"
    AURORA_SAFE_GRAPHICS=1
    export WLR_RENDERER GSK_RENDERER AURORA_SAFE_GRAPHICS
fi

if aurora_software_gpu; then
    : "${WLR_RENDERER:=pixman}" "${GSK_RENDERER:=cairo}"
    export WLR_RENDERER GSK_RENDERER
    if aurora_hyperv_gpu; then
        AURORA_HYPERV_SOFTWARE=1
        export AURORA_HYPERV_SOFTWARE
    fi
fi
