<?xml version="1.0"?>
<!-- Compositor config for the login screen: no keybindings, no menus. -->
<labwc_config>
  <core><decoration>client</decoration></core>
  <theme><name>Aurora</name></theme>
  <keyboard><default /><numlock>on</numlock></keyboard>
  <mouse><default /></mouse>
  <libinput>
    <device category="touchpad"><tap>yes</tap></device>
  </libinput>
</labwc_config>
