# Aurora window decorations for labwc

border.width: 1
padding.width: 8
padding.height: 6

window.active.border.color: #3a3150
window.inactive.border.color: #26212f

window.active.title.bg.color: #1f1a2b
window.inactive.title.bg.color: #17131f
window.active.label.text.color: #f2eefa
window.inactive.label.text.color: #8d869c
window.label.text.justify: center

window.active.button.unpressed.image.color: #f2eefa
window.inactive.button.unpressed.image.color: #6f6880
window.active.button.hover.image.color: #ffffff
window.active.button.close.hover.image.color: #ff6f91

window.button.width: 28
window.button.spacing: 4
window.button.hover.bg.corner-radius: 999
window.button.hover.bg.color: #332a45

# Menus: roomy items, a quiet border and a soft highlight (labwc menus can't be rounded).
menu.width.min: 260
menu.width.max: 360
menu.items.padding.x: 16
menu.items.padding.y: 9
menu.items.bg.color: #1f1a2b
menu.items.text.color: #f2eefa
menu.items.active.bg.color: #3b2f58
menu.items.active.text.color: #ffffff
menu.border.width: 1
menu.border.color: #4a3f63
menu.separator.width: 1
menu.separator.padding.width: 12
menu.separator.padding.height: 4
menu.separator.color: #3a3150

osd.bg.color: #1f1a2b
osd.border.color: #3a3150
osd.border.width: 1
osd.label.text.color: #f2eefa
osd.window-switcher.width: 50%
osd.window-switcher.item.active.border.color: #a970ff
osd.workspace-switcher.boxes.width: 24
osd.workspace-switcher.boxes.height: 16

window.active.shadow.size: 40
window.inactive.shadow.size: 20
window.active.shadow.color: #00000066
window.inactive.shadow.color: #00000033

snapping.overlay.region.bg.enabled: yes
snapping.overlay.region.bg.color: #a970ff33
snapping.overlay.region.border.color: #a970ff
