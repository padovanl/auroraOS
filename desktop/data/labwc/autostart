# Aurora session autostart (run by labwc with sh).

dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
    LANG LANGUAGE LC_TIME LC_NUMERIC LC_MONETARY LC_MEASUREMENT LC_PAPER \
    XKB_DEFAULT_LAYOUT XKB_DEFAULT_VARIANT XKB_DEFAULT_OPTIONS \
    QT_QPA_PLATFORM MOZ_ENABLE_WAYLAND >/dev/null 2>&1

xdg-user-dirs-update >/dev/null 2>&1

# Display layout saved by Settings.
[ -r "$HOME/.config/aurora/displays.sh" ] && sh "$HOME/.config/aurora/displays.sh"

# The shell draws the bar, dock and desktop: if it ever crashes, start it again
# (at most 5 times a minute), until the compositor itself exits.
(
    log="${XDG_RUNTIME_DIR:-/tmp}/aurora-shell.log"
    : >"$log"
    tries=0 since=$(date +%s)
    while :; do
        aurora-shell >>"$log" 2>&1
        [ -e "${XDG_RUNTIME_DIR:-/tmp}/aurora-logging-out" ] && break
        [ -n "$LABWC_PID" ] && ! kill -0 "$LABWC_PID" 2>/dev/null && break
        now=$(date +%s)
        [ $((now - since)) -gt 60 ] && tries=0 since=$now
        tries=$((tries + 1))
        [ "$tries" -gt 5 ] && break
        echo "aurora-shell: restarting after exit" >>"$log"
        sleep 1
    done
) &

# Password prompts for administrative actions.
/usr/libexec/polkit-mate-authentication-agent-1 >/dev/null 2>&1 &

# Apps the user (or packages) registered in XDG autostart.
aurora-autostart >/dev/null 2>&1 &
aurora-idle >/dev/null 2>&1 &

# "Install Aurora OS" boot entry: go straight to the installer.
# Otherwise run the welcome app once per user.
if grep -qw aurora.install /proc/cmdline; then
    aurora-installer >/dev/null 2>&1 &
elif [ ! -f "$HOME/.config/aurora/welcome-done" ]; then
    aurora-welcome >/dev/null 2>&1 &
fi
