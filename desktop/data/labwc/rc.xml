<?xml version="1.0"?>
<!-- Aurora OS default compositor configuration (labwc). Copy to
     ~/.config/labwc/rc.xml to customise. -->
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>6</gap>
    <adaptiveSync>no</adaptiveSync>
    <reuseOutputMode>yes</reuseOutputMode>
  </core>

  <placement>
    <policy>cascade</policy>
  </placement>

  <theme>
    <name>Aurora</name>
    <cornerRadius>12</cornerRadius>
    <keepBorder>yes</keepBorder>
    <dropShadows>yes</dropShadows>
    <font place="ActiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="MenuItem"><name>Inter</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Inter</name><size>10</size></font>
    <titlebar>
      <layout>close,iconify,max:</layout>
      <showTitle>yes</showTitle>
    </titlebar>
  </theme>

  <windowSwitcher show="yes" preview="yes" outlines="yes">
    <fields>
      <field content="identifier" width="25%" />
      <field content="title" width="75%" />
    </fields>
  </windowSwitcher>

  <desktops number="4">
    <popupTime>600</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>

  <snapping>
    <range>12</range>
    <overlay enabled="yes"><delay inner="300" outer="300" /></overlay>
    <topMaximize>yes</topMaximize>
  </snapping>

  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <keyboard>
    <repeatRate>30</repeatRate>
    <repeatDelay>400</repeatDelay>
    <numlock>on</numlock>

    <!-- Launcher: tap Super, or Super+Space / Super+A -->
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="aurora-shell launcher" /></keybind>
    <keybind key="W-space"><action name="Execute" command="aurora-shell launcher" /></keybind>
    <keybind key="W-a"><action name="Execute" command="aurora-shell launcher" /></keybind>
    <keybind key="W-s"><action name="Execute" command="aurora-shell quick-settings" /></keybind>

    <!-- Apps -->
    <keybind key="W-Return"><action name="Execute" command="x-terminal-emulator" /></keybind>
    <keybind key="C-A-t"><action name="Execute" command="x-terminal-emulator" /></keybind>
    <keybind key="W-e"><action name="Execute" command="aurora-files" /></keybind>
    <keybind key="W-i"><action name="Execute" command="aurora-settings" /></keybind>
    <keybind key="W-l"><action name="Execute" command="aurora-lock" /></keybind>

    <!-- Windows -->
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="W-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="W-Up"><action name="Maximize" /></keybind>
    <keybind key="W-Down"><action name="UnMaximize" /></keybind>
    <keybind key="W-h"><action name="Iconify" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="W-f"><action name="ToggleFullscreen" /></keybind>
    <keybind key="A-space"><action name="ShowMenu" menu="client-menu" atCursor="no" /></keybind>

    <!-- Workspaces -->
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" /></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" /></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" /></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" /></keybind>
    <keybind key="W-5"><action name="GoToDesktop" to="5" /></keybind>
    <keybind key="W-6"><action name="GoToDesktop" to="6" /></keybind>
    <keybind key="W-7"><action name="GoToDesktop" to="7" /></keybind>
    <keybind key="W-8"><action name="GoToDesktop" to="8" /></keybind>
    <keybind key="W-9"><action name="GoToDesktop" to="9" /></keybind>
    <keybind key="W-S-5"><action name="SendToDesktop" to="5" /></keybind>
    <keybind key="W-S-6"><action name="SendToDesktop" to="6" /></keybind>
    <keybind key="W-S-7"><action name="SendToDesktop" to="7" /></keybind>
    <keybind key="W-S-8"><action name="SendToDesktop" to="8" /></keybind>
    <keybind key="W-S-9"><action name="SendToDesktop" to="9" /></keybind>
    <keybind key="C-A-Left"><action name="GoToDesktop" to="left" wrap="yes" /></keybind>
    <keybind key="C-A-Right"><action name="GoToDesktop" to="right" wrap="yes" /></keybind>

    <!-- Screenshots -->
    <keybind key="Print"><action name="Execute" command="aurora-shell screenshot" /></keybind>
    <keybind key="S-Print"><action name="Execute" command="aurora-shell screenshot area" /></keybind>
    <keybind key="W-S-s"><action name="Execute" command="aurora-shell screenshot area" /></keybind>

    <!-- Media keys -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="aurora-shell volume up" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="aurora-shell volume down" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="aurora-shell volume mute" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="aurora-shell brightness up" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="aurora-shell brightness down" /></keybind>
  </keyboard>

  <mouse>
    <default />
    <doubleClickTime>400</doubleClickTime>
  </mouse>

  <libinput>
    <device category="touchpad">
      <naturalScroll>yes</naturalScroll>
      <tap>yes</tap>
      <disableWhileTyping>yes</disableWhileTyping>
    </device>
  </libinput>

</labwc_config>
