[Desktop Entry]
Name=Files
Comment=Browse and organize your files
Exec=aurora-files %U
Icon=org.aurora.Files
Terminal=false
Type=Application
Categories=GTK;System;Utility;Core;FileManager;
MimeType=inode/directory;
Keywords=folder;manager;explore;disk;filesystem;
StartupNotify=true
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=aurora-files
