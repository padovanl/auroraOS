[Desktop Entry]
Name=USB Stick Writer
Comment=Put a disk image on a USB stick, and check that it arrived
Keywords=usb;stick;image;iso;img;write;burn;flash;etcher;rufus;bootable;installer;
Exec=aurora-usb-writer %f
Icon=org.aurora.UsbWriter
Type=Application
Categories=System;
MimeType=application/x-cd-image;application/x-raw-disk-image;application/x-iso9660-image;
StartupNotify=true
